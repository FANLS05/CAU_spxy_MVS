# =============================================================================
# 第三方二进制 / 预编译包 —— 都能从官方下载,不进仓库
# =============================================================================
OpenMVS_Windows_x64/
OpenMVS_Windows_x64.zip
tools/colmap/
tools/ffmpeg/
tools/plugins/
*.zip

# =============================================================================
# 重建中间产物 —— 占空间且可重生
# =============================================================================
# COLMAP 中间态
work/*/db.db
work/*/dense/images/
work/*/dense/stereo/
work/*/dense/run-colmap-*.sh

# 保留:work/*/sparse/0/      稀疏模型,只有几 MB,是重跑去畸变的输入
# 保留:work/*/dense/sparse/  去畸变后的位姿,投影工具要

# OpenMVS 中间态
work/*/mvs/depth*.dmap
work/*/mvs/scene_dense.ply
work/*/mvs/*.log
*.log

# 保留:work/*/dense/sparse/(投影工具要的位姿)
# 保留:work/*/mvs/ 下的 .ply / .glb / .png 成品

# =============================================================================
# 分割产物(mask / 叠加图 / 标签) —— 可由 sam3_masks / mask_to_points 重建
# =============================================================================
masks/
masks_door/
out/

# rock 场景原图与重建产物体积过大,不发布
data/rock/
work/rock/

# =============================================================================
# 工具噪音 / 个人痕迹
# =============================================================================
__pycache__/
*.pyc
.playwright-mcp/
*.psz
building/building.psz

# =============================================================================
# 系统
# =============================================================================
Thumbs.db
desktop.ini
.DS_Store
